<Project Sdk="Microsoft.NET.Sdk">

  <!-- Not referenced by JobsFinder.Api on purpose: the API has no browser, and nothing in it can open one (JF-9, D2). -->
  <ItemGroup>
    <ProjectReference Include="..\JobsFinder.Application\JobsFinder.Application.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Playwright" Version="1.62.0" />
  </ItemGroup>

  <ItemGroup>
    <EmbeddedResource Include="Scripts\*.js" LogicalName="%(Filename)%(Extension)" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="JobsFinder.IntegrationTests" />
  </ItemGroup>

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
  </PropertyGroup>

</Project>
